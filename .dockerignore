# Build context of the Dockerfile. The image copies only what it needs (explicit COPYs in the Dockerfile); this list
# keeps secrets, dependencies, caches and everything not needed for the build out of the context.
# public/vendor stays in: Stoplight Elements with its LICENSE (A389).
.git
.github
.ddev
.superpowers
.claude
.idea
.vscode
.env
.env.*
**/node_modules
.pnpm-store
vendor
storage
bootstrap/cache/*.php
public/build
public/hot
public/storage
coverage
e2e
tests
scripts
*.log
**/.DS_Store
docker-compose*.yml
CLAUDE.md

# docs: the workspace manifest (frozen lockfile) and the pages the MCP references read at runtime (DocReference, A409);
# a new reference page needs its line here and its COPY in the Dockerfile
docs/*
!docs/package.json
!docs/en
docs/en/*
!docs/en/concepts
docs/en/concepts/*
!docs/en/concepts/views.md
!docs/en/concepts/rich-text.md
!docs/en/concepts/types-and-properties.md

# prototypes: only the manifests, so pnpm's frozen lockfile matches the workspace
prototypes/*/*
!prototypes/*/package.json
