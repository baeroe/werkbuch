#!/bin/sh
# A fake Claude Code for the tests and the acceptance of the runner (spec 14): it answers --version, auth status and
# mcp list, and a headless run (-p) writes stream-json. What it does is in the prompt on standard input:
#   sleep     works until SIGTERM, then ends
#   stubborn  ignores SIGTERM (the runner has to SIGKILL it)
#   commit    commits a file in the working folder and pushes it
#   fail      ends with an error result
#   review    answers a review with the verdict approve
#   leak      prints the run token (the runner has to blank it)
#   werkbuch  shows a second MCP server with werkbuch's tools
# FAKE_ARGS (a file) gets the arguments of a run, FAKE_LINES the number of text lines (default 3).
case "$1" in
--version) echo "2.1.330 (Claude Code)"; exit 0 ;;
auth) echo '{"loggedIn": true, "authMethod": "claude.ai"}'; exit 0 ;;
mcp) printf 'Checking MCP server health…\n\nplaywright: npx @playwright/mcp - ✔ Connected\n'; exit 0 ;;
esac

session="sess-new"
prev=""
for a in "$@"; do
	[ "$prev" = "--resume" ] && session="$a"
	prev="$a"
done
[ -n "$FAKE_ARGS" ] && printf '%s\n' "$@" > "$FAKE_ARGS"
prompt=$(cat)

tools='"Bash","mcp__werkbuch-run__manage-work-items"'
case "$prompt" in *werkbuch*) tools="$tools"',"mcp__skilltri__werkbuch_manage-work-items"' ;; esac
printf '{"type":"system","subtype":"init","session_id":"%s","model":"fake-model","tools":[%s],"mcp_servers":[{"name":"werkbuch-run","status":"connected"}]}\n' "$session" "$tools"

n=${FAKE_LINES:-3}
i=1
while [ "$i" -le "$n" ]; do
	printf '{"type":"assistant","message":{"content":[{"type":"text","text":"step %s"}]},"session_id":"%s"}\n' "$i" "$session"
	i=$((i + 1))
done
printf '{"type":"assistant","message":{"content":[{"type":"tool_use","name":"Bash","input":{"command":"git status"}}]}}\n'

case "$prompt" in
*stubborn*)
	trap '' TERM
	sleep 600 &
	while :; do wait $! && break; done
	;;
*sleep*)
	trap 'exit 143' TERM
	sleep 600 &
	wait $!
	;;
esac
case "$prompt" in
*leak*) printf '{"type":"assistant","message":{"content":[{"type":"text","text":"my token is %s"}]}}\n' "$WERKBUCH_RUN_TOKEN" ;;
esac
case "$prompt" in
*commit*)
	echo "work" > work.txt
	git add work.txt >/dev/null 2>&1
	git commit -q -m "work of the agent" >/dev/null 2>&1
	git push -q >/dev/null 2>&1
	;;
esac
case "$prompt" in
*fail*)
	printf '{"type":"result","subtype":"error_during_execution","is_error":true,"result":"the tests do not pass","session_id":"%s"}\n' "$session"
	echo "boom" >&2
	exit 1
	;;
*review*)
	printf '{"type":"result","subtype":"success","is_error":false,"result":"**Verdict:** approve\\n\\nNo findings.","session_id":"%s","usage":{"input_tokens":100,"output_tokens":20}}\n' "$session"
	;;
*)
	printf '{"type":"result","subtype":"success","is_error":false,"result":"Done: the change is pushed.","session_id":"%s","usage":{"input_tokens":1200,"cache_read_input_tokens":300,"output_tokens":450}}\n' "$session"
	;;
esac
exit 0
