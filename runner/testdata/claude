#!/bin/sh
# A fake Claude Code for the tests and the acceptance of the runner (spec 14): it answers --version, auth status and
# mcp list, and a headless run (-p) writes stream-json. What it does is in the prompt on standard input:
#   sleep     works until SIGTERM, then ends
#   stubborn  ignores SIGTERM (the runner has to SIGKILL it)
#   commit    commits a file in the working folder and pushes it
#   fail      ends with an error result
#   background  leaves a process in its group that ignores SIGTERM
#   nap       works a second and fails when another run works in the same folder
#   review    answers a review with the verdict approve
#   leak      prints the run token of its MCP config (the runner has to blank it)
#   second-access  shows a second MCP server with werkbuch's tools
#   awaitrenew  waits until the runner renewed the git token (its file changes), then FAKE_PUSH_DELAY seconds
#   usegh     runs the gh at $FAKE_GH by its path (gh reads the token of the run from GH_CONFIG_DIR)
# FAKE_ARGS (a file) gets the arguments of a run, FAKE_ENV its environment, FAKE_LS the files of --add-dir,
# FAKE_LINES the number of text lines (default 3).
case "$1" in
--version) echo "2.1.330 (Claude Code)"; exit 0 ;;
auth) echo '{"loggedIn": true, "authMethod": "claude.ai"}'; exit 0 ;;
mcp) printf 'Checking MCP server health…\n\nplaywright: npx @playwright/mcp - ✔ Connected\n'; exit 0 ;;
esac

session="sess-new"
mcp=""
prev=""
for a in "$@"; do
	[ "$prev" = "--resume" ] && session="$a"
	[ "$prev" = "--mcp-config" ] && mcp="$a"
	[ "$prev" = "--add-dir" ] && adddir="$a"
	prev="$a"
done
[ -n "$FAKE_ARGS" ] && printf '%s\n' "$@" > "$FAKE_ARGS"
[ -n "$FAKE_ENV" ] && env > "$FAKE_ENV"
# what a light run could read besides the worktree
[ -n "$FAKE_LS" ] && [ -n "$adddir" ] && ls -A "$adddir" > "$FAKE_LS"
# the prepared context of a light run, kept for the test (the private folder goes with the run)
[ -n "$FAKE_CONTEXT" ] && [ -n "$adddir" ] && cp "$adddir"/*.txt "$adddir"/*.diff "$FAKE_CONTEXT"/ 2>/dev/null
prompt=$(cat | tr "[:upper:]" "[:lower:]")
[ -n "$FAKE_PROMPT" ] && printf '%s' "$prompt" > "$FAKE_PROMPT"

tools='"Bash","mcp__werkbuch-run__manage-work-items"'
case "$prompt" in *second-access*) tools="$tools"',"mcp__skilltri__werkbuch_manage-work-items"' ;; esac
printf '{"type":"system","subtype":"init","session_id":"%s","model":"fake-model","tools":[%s],"mcp_servers":[{"name":"werkbuch-run","status":"connected"}]}\n' "$session" "$tools"

n=${FAKE_LINES:-3}
i=1
while [ "$i" -le "$n" ]; do
	printf '{"type":"assistant","message":{"content":[{"type":"text","text":"step %s"}]},"session_id":"%s"}\n' "$i" "$session"
	i=$((i + 1))
done
printf '{"type":"assistant","message":{"content":[{"type":"tool_use","name":"Bash","input":{"command":"git status"}}]}}\n'

case "$prompt" in
*stubborn*)
	trap '' TERM
	sleep 600 &
	while :; do wait $! && break; done
	;;
*sleep*)
	trap 'exit 143' TERM
	sleep 600 &
	wait $!
	;;
esac
case "$prompt" in
*background*)
	# leaves a process in its group that ignores SIGTERM and holds the output
	(trap '' TERM; exec sleep 600) &
	[ -n "$FAKE_BG" ] && echo $! > "$FAKE_BG"
	;;
esac
case "$prompt" in
*nap*)
	if [ -e .nap ]; then
		printf '{"type":"result","subtype":"error_during_execution","is_error":true,"result":"another run works in this folder"}\n'
		exit 1
	fi
	touch .nap
	sleep 1
	rm -f .nap
	;;
esac
case "$prompt" in
*leak*)
	token=$(sed -n 's/.*"Bearer \([^"]*\)".*/\1/p' "$mcp")
	printf '{"type":"assistant","message":{"content":[{"type":"text","text":"my token is %s, env %s"}]}}\n' "$token" "${WERKBUCH_RUN_TOKEN:-unset}"
	;;
esac
case "$prompt" in
*awaitrenew*)
	first=$(cat "$WERKBUCH_GIT_TOKEN_FILE")
	i=0
	while [ "$(cat "$WERKBUCH_GIT_TOKEN_FILE")" = "$first" ] && [ "$i" -lt 400 ]; do
		sleep 0.05
		i=$((i + 1))
	done
	sleep "${FAKE_PUSH_DELAY:-0}"
	;;
esac
case "$prompt" in
*usegh*) "$FAKE_GH" pr view >/dev/null 2>&1 ;;
esac
case "$prompt" in
*commit*)
	echo "work" > work.txt
	git add work.txt >/dev/null 2>&1
	git commit -q -m "work of the agent" >/dev/null 2>&1
	git push -q >/dev/null 2>&1
	;;
esac
case "$prompt" in
*fail*)
	printf '{"type":"result","subtype":"error_during_execution","is_error":true,"result":"the tests do not pass","session_id":"%s"}\n' "$session"
	echo "boom" >&2
	exit 1
	;;
*review*)
	printf '{"type":"result","subtype":"success","is_error":false,"result":"**Verdict:** approve\\n\\nNo findings.","session_id":"%s","usage":{"input_tokens":100,"output_tokens":20}}\n' "$session"
	;;
*)
	printf '{"type":"result","subtype":"success","is_error":false,"result":"Done: the change is pushed.","session_id":"%s","usage":{"input_tokens":1200,"cache_read_input_tokens":300,"output_tokens":450}}\n' "$session"
	;;
esac
exit 0
