APP_NAME=werkbuch
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://werkbuch.ddev.site

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DDEV defaults (CI sets its own values)
DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=db
DB_USERNAME=db
DB_PASSWORD=db

# seven days without activity before the next sign-in
SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# DDEV ships Mailpit: https://werkbuch.ddev.site:8026
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="werkbuch@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# search (phase 6)
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=ddev-werkbuch-master-key

# live updates (phase 8)
REVERB_APP_ID=werkbuch
REVERB_APP_KEY=werkbuch-dev-key
REVERB_APP_SECRET=werkbuch-dev-secret
REVERB_HOST=werkbuch.ddev.site
REVERB_PORT=6001
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=6001

# IPs/CIDR of the reverse proxies, empty = localhost and private networks
TRUSTED_PROXIES=

# created by php artisan app:ensure-admin (local development only)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password

ATTACHMENTS_MAX_MB=25
NOTIFICATION_MAIL_DELAY=5
WEBHOOKS_ALLOW_PRIVATE=false

VITE_APP_NAME="${APP_NAME}"
