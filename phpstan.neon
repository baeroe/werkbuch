includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    parseModelCastsMethod: true
    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - routes
    ignoreErrors:
        # the published config names the class of Media Library Pro, which is not installed
        -
            identifier: class.notFound
            path: config/media-library.php
