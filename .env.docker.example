# werkbuch stack: copy to `.env` next to docker-compose.yml and fill it in.
# Only the variables of this file reach the containers. Other settings go into the environment of a service in
# docker-compose.override.yml: never set a variable starting with PHP_, NGINX_, SSL_, LOG_ or TRUSTED_PROXY to an
# empty value there, the web service refuses to start.
# Keep storage/app/.app-key (in the werkbuch-data volume): it encrypts webhook secrets and second factors.

# Public address of the instance, without a trailing slash (behind a reverse proxy: its https address).
APP_URL=https://pm.example.com
# Language of the organization at the first start: en or de.
# APP_LOCALE=en
# Image to run (default baeroe/werkbuch:latest).
# WERKBUCH_IMAGE=baeroe/werkbuch:latest
# Address and port the web service listens on at the host (default 0.0.0.0:7740; 127.0.0.1 behind a proxy on the same host).
WERKBUCH_BIND=0.0.0.0
WERKBUCH_PORT=7740

# First admin account, created at the first start. Remove ADMIN_PASSWORD once the admin exists
# (set a new password later with: docker compose exec werkbuch php artisan app:reset-password <email>).
ADMIN_EMAIL=admin@example.com
# Needed at the first start only; without it no account is made and the log says so.
ADMIN_PASSWORD=

# Passwords of the database. Choose long random values (openssl rand -hex 24).
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Master key of Meilisearch: at least 16 characters, e.g. openssl rand -hex 32.
MEILISEARCH_KEY=

# Keys of the app. Empty = made at the first start and kept in the data volume.
# APP_KEY=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# Networks of your reverse proxy, whose X-Forwarded-* headers are believed. Empty = the private networks.
# TRUSTED_PROXIES=

# Mail: log writes mails to the log, smtp sends them.
# MAIL_MAILER=log
# MAIL_SCHEME=
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=werkbuch@example.com
# MAIL_FROM_NAME=werkbuch

# Largest upload in MB (PHP and nginx limits are 30 and 32 MB).
# ATTACHMENTS_MAX_MB=25
# Minutes until the notifications of a work item go out in one mail.
# NOTIFICATION_MAIL_DELAY=5
# Allow webhooks to private networks (10.x, 192.168.x, ...).
# WEBHOOKS_ALLOW_PRIVATE=false
# Requests per minute and token, session or IP.
# API_RATE_LIMIT=600
# API_SESSION_RATE_LIMIT=3000
# MCP_RATE_LIMIT=300
